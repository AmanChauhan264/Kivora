{
  "name": "@kivora/config",
  "version": "1.0.0",
  "private": true,
  "description": "Shared configurations for ESLint, TypeScript, and Tailwind in Kivora",
  "main": "./index.js",
  "files": [
    "eslint",
    "tailwind",
    "typescript",
    "index.js"
  ],
  "exports": {
    ".": "./index.js",
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/node.json": "./typescript/node.json",
    "./typescript/react.json": "./typescript/react.json",
    "./typescript/*": "./typescript/*",
    "./eslint/*": "./eslint/*",
    "./tailwind/*": "./tailwind/*",
    "./*": "./*"
  }
}
