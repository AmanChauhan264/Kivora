{
  "name": "@kivora/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript domain contracts, interfaces and DTOs for Kivora",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@kivora/config": "workspace:*",
    "typescript": "^5.7.2"
  }
}
