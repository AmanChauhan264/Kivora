# Kivora Backend Environment Variables
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://kivora_dev:kivora_dev_secret@localhost:5432/kivora_db?schema=public
REDIS_URL=redis://:kivora_redis_secret@localhost:6379

JWT_ACCESS_SECRET=kivora_dev_jwt_access_secret_do_not_use_in_prod_min_32_chars
JWT_REFRESH_SECRET=kivora_dev_jwt_refresh_secret_do_not_use_in_prod_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Initial Administrative Provisioning (Seed)
INITIAL_ADMIN_EMAIL=admin@kivora.internal
INITIAL_ADMIN_PASSWORD=KivoraAdmin@2026!SecureRoot

RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

