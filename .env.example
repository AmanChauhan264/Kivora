# ==============================================================================
# Kivora Root Environment Configuration Template (.env.example)
# Copy this file to .env for local development: cp .env.example .env
# Never commit actual credentials or production secrets to source control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Docker Compose - Local PostgreSQL Configuration
POSTGRES_USER=kivora_dev
POSTGRES_PASSWORD=kivora_dev_secret
POSTGRES_DB=kivora_db
POSTGRES_PORT=5432

# Docker Compose - Local Redis Configuration
REDIS_PASSWORD=kivora_redis_secret
REDIS_PORT=6379

# Database & Cache Connection Strings (used by backend)
DATABASE_URL=postgresql://kivora_dev:kivora_dev_secret@localhost:5432/kivora_db?schema=public
REDIS_URL=redis://:kivora_redis_secret@localhost:6379

# Backend API Configuration
PORT=5000
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Client URLs
SELLER_WEB_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3002
CLIENT_MOBILE_SCHEME=kivora://

# Authentication Secrets (Generate secure random 64-char strings in production)
JWT_ACCESS_SECRET=kivora_dev_jwt_access_secret_do_not_use_in_prod_min_32_chars
JWT_REFRESH_SECRET=kivora_dev_jwt_refresh_secret_do_not_use_in_prod_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay - Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret

